# Application Settings
PROJECT_NAME="Order Fulfillment & Inventory Management Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Security & JWT
SECRET_KEY="supersecretjwtkeyfororderfulfillmentandinventorymanagementplatform2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL default; supports SQLite for local dev/testing without local Postgres)
DATABASE_URL="sqlite:///./order_fulfillment.db"
# For production / docker compose with PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/order_fulfillment_db"

POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="order_fulfillment_db"
POSTGRES_PORT=5432

# Redis & Celery (Optional / Bonus Features)
REDIS_URL="redis://localhost:6337/0"

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
